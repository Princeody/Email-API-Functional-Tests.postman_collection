  "item": [
    {
      "name": "Valid Request - 202",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 202', function () {",
              "    pm.response.to.have.status(202);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"to\": \"user@example.com\", \"subject\": \"Welcome!\", \"body\": \"Thanks for signing up.\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/send-email",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "send-email"
          ]
        }
      },
      "response": []
    },
